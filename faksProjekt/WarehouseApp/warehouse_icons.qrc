<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
    <!-- Paths are relative to this .qrc file (source directory).          -->
    <!-- The icons/ sub-directory is created at build time by IconGenerator.-->
    <file alias="product.png">icons/product.png</file>
    <file alias="supplier.png">icons/supplier.png</file>
    <file alias="warning.png">icons/warning.png</file>
  </qresource>
</RCC>
